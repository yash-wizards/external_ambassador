# API origin only. Do not include a trailing /api.
# Example: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# mock = labeled local adapter (default when Auth0 is not configured)
# live = Auth0 + existing INTOTO APIs. Vendor data stays on the mock adapter.
VITE_AUTH_MODE=mock

# Required only for VITE_AUTH_MODE=live. Same Auth0 application as the admin portal.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Comma-separated parent origins allowed to embed this app.
# Leave empty in a production build to deny all framing.
# Local parent test page runs at http://localhost:5199
VITE_FRAME_ANCESTORS=http://localhost:5199,http://127.0.0.1:5199

VITE_API_TIMEOUT_MS=30000
